# Copy to backend/.env. Every blank runs in mock mode.
# NEVER put a real key in this file: it is committed. Real values go in
# backend/.env (git-ignored) or in your host's secret settings.

ENVIRONMENT=dev                      # production refuses to start with unsafe settings
DATABASE_URL=sqlite:///./blueproof.db
CORS_ORIGINS=*                       # a pilot should list its app and console origins

# ---- Auth -----------------------------------------------------------------
# Required in production: 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
TOKEN_TTL_HOURS=12
# Demo accounts (PINs in backend/app/seed.py). Defaults on in dev, off in production.
DEMO_SEED=
# Production: the first admin, created once at startup if no admin exists.
ADMIN_PHONE=
ADMIN_PIN=

# ---- Evidence and the payment gate ------------------------------------------
PHOTO_DIR=./data/photos
GEOFENCE_RADIUS_M=150
REQUIRE_GPS=true
MIN_DAYS_BETWEEN_PAID_EVENTS=7
PAYOUT_PER_VERIFIED_EVENT=150
MIN_VERIFICATION_CONFIDENCE=0.6
# Blank keeps photographs. Set a number once the retention policy is decided.
PHOTO_RETENTION_DAYS=

# ---- Llama (any OpenAI-compatible chat endpoint with vision) -------------------
# e.g. https://openrouter.ai/api/v1/chat/completions
LLAMA_API_URL=
LLAMA_API_KEY=
LLAMA_MODEL=meta-llama/llama-3.2-90b-vision-instruct
# Ask the verifier this many times; confidence = share of samples that agree.
# With 3, MIN_VERIFICATION_CONFIDENCE=0.6 means majority, 0.9 means unanimity.
VERIFIER_SAMPLES=3
VERIFIER_SAMPLE_TEMPERATURE=0.7
# Escalate submissions that arrive without a plot marker photograph.
REQUIRE_MARKER=false

# ---- Sentinel-2 via Copernicus Data Space ---------------------------------------
# Create an OAuth client at https://shapps.dataspace.copernicus.eu/dashboard/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
SATELLITE_LOOKBACK_DAYS=90
SATELLITE_INTERVAL_DAYS=5

# ---- M-Pesa B2C (Daraja) ------------------------------------------------------
# mock settles instantly. sandbox / production use B2C, which pays the monitor.
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_INITIATOR_NAME=
# Generated on the Daraja portal from the initiator password. Not the password.
MPESA_SECURITY_CREDENTIAL=
# Public HTTPS base URL of this API; Safaricom posts results to /mpesa/b2c/result
PUBLIC_BASE_URL=
# Long random string; appended to the callback URLs and checked on arrival.
MPESA_CALLBACK_TOKEN=

# ASSUMPTION awaiting validation. Do not quote any figure derived from this
# until KMFRI or an approved methodology confirms it.
CO2_TONNES_PER_HA_YEAR=3.0
